# Folder unggahan hanya untuk gambar/PDF, jangan biarkan file di sini dieksekusi
# sebagai script meskipun ada yang berhasil menyelundupkan ekstensi berbahaya.

Options -Indexes -ExecCGI
php_flag engine off

<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
